# Canonical origin used for SEO tags. No trailing slash.
# On Vercel this falls back to the production domain when unset.
SITE_URL=http://localhost:4321

# Optional. When set, the GTM container loads after idle.
# The form_submit dataLayer event is pushed either way.
PUBLIC_GTM_ID=

# Form storage. Vercel sets this when a Blob store is connected to the project.
# Leave empty locally and submissions go to data/submissions.json.
BLOB_READ_WRITE_TOKEN=

# CMS sign-in at /admin on the deployed site (GitHub OAuth app).
# Callback URL: https://<your-domain>/api/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
