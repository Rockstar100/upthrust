---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import LogoRail from '../components/LogoRail.astro';
import Services from '../components/Services.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';

const site = await getEntry('site', 'home');
if (!site) {
  throw new Error('Missing site content entry: home');
}

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const { title, description } = site.data;
---

<Base title={`${title} — Bold design that performs`} description={description}>
  <div id="top">
    <div class="top">
      <Header contactLabel={site.data.contactLabel} />
      <main id="main">
        <Hero {...site.data.hero} />
        <LogoRail stat={site.data.stat} logos={site.data.logos} />
      </main>
    </div>
    <Services label={site.data.servicesLabel} contactLabel="Contact" services={services.map((entry) => entry.data)} />
    <Footer {...site.data.footer} />
    <ContactForm {...site.data.form} />
  </div>
</Base>
