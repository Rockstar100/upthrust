---
interface Props {
  title: string;
  notes: string[];
}
const { title, notes } = Astro.props;

// Keep in sync with the statue preload in layouts/Base.astro.
const statueSrcset = '/images/statue-600.webp 600w, /images/statue.webp 1092w';
const statueSizes = '(min-width: 48rem) min(37.9vw, 546px), 62.7vw';

// Desktop positions are the Figma frame (1440 x 1079); mobile positions use a 375-wide frame.
const layers = [
  { cls: 'that', src: '/hero/that.svg', w: 294.04, h: 91.55, x: 796, y: 494, mx: 222, my: 199, mw: 128 },
  { cls: 'bold', src: '/hero/bold.svg', w: 1363.12, h: 160.6, x: 38.44, y: 81, mx: 10, my: 28, mw: 355 },
  {
    cls: 'blueprint',
    src: '/hero/blueprint.webp',
    srcset: '/hero/blueprint-720.webp 720w, /hero/blueprint.webp 1432w',
    sizes: '(min-width: 48rem) min(49.7vw, 716px), 54.7vw',
    w: 716, h: 712.04, x: 724, y: 366.96, mx: 170, my: 250, mw: 205,
  },
  {
    cls: 'statue',
    src: '/images/statue.webp',
    srcset: statueSrcset,
    sizes: statueSizes,
    w: 546, h: 685, x: 447, y: 173, mx: 70, my: 60, mw: 235, priority: true,
  },
  { cls: 'performs', src: '/hero/performs.svg', w: 1129.59, h: 160.59, x: 155, y: 826, mx: 16, my: 345, mw: 343 },
  { cls: 'comfortable', src: '/hero/comfortable.svg', w: 229, h: 64, x: 1157, y: 365, mx: 214, my: 418, mw: 140 },
  { cls: 'underline', src: '/hero/underline.webp', w: 172, h: 9, x: 1157, y: 435, mx: 214, my: 460, mw: 105 },
  { cls: 'strategy', src: '/hero/strategy.svg', w: 188, h: 70, x: 277, y: 438, mx: 20, my: 418, mw: 128 },
  { cls: 'identity', src: '/hero/identity.svg', w: 251, h: 141, x: 73, y: 590, mx: 20, my: 485, mw: 170 },
];
---

<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="sr-only">{title}</h1>
  <p class="sr-only">{notes.join('. ')}.</p>
  <div class="hero-stage" aria-hidden="true">
    {
      layers.map((layer) => (
        <img
          class={`hero-layer hero-${layer.cls}`}
          src={layer.src}
          srcset={layer.srcset}
          sizes={layer.sizes}
          alt=""
          width={layer.w}
          height={layer.h}
          style={`--x:${layer.x};--y:${layer.y};--w:${layer.w};--mx:${layer.mx};--my:${layer.my};--mw:${layer.mw}`}
          fetchpriority={layer.priority ? 'high' : undefined}
          decoding={layer.priority ? 'sync' : 'async'}
        />
      ))
    }
  </div>
</section>
