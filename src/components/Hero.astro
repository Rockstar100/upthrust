---
interface Props {
  line1: string;
  line2: string;
  line3: string;
  kicker: string;
  points: string[];
  aside: string;
}
const { line1, line2, line3, kicker, points, aside } = Astro.props;
---

<section class="hero" aria-labelledby="page-title">
  <div class="hero-grid">
    <h1 id="page-title">
      <span class="hero-line hero-line-top">{line1}<span class="sr-only"> </span></span>
      <span class="hero-line hero-that">{line2}<span class="sr-only"> </span></span>
      <span class="hero-line hero-line-bottom">{line3}</span>
    </h1>
    <p class="hero-kicker">{kicker}</p>
    <p class="hero-points">
      {points[0]?.replace(/\.$/, '')} · {points[1]?.replace(/\.$/, '')} ·<br />
      {points[2]?.replace(/\.$/, '')} ·
    </p>
    <div class="bust">
      <img
        src="/images/statue.webp"
        alt=""
        width="1436"
        height="1800"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <p class="hero-aside">{aside}</p>
  </div>
  <svg class="wireframe" viewBox="0 0 320 260" aria-hidden="true" focusable="false">
    <g fill="none" stroke="currentColor" stroke-width="0.7">
      <circle cx="132" cy="132" r="96" />
      <ellipse cx="132" cy="132" rx="96" ry="34" />
      <ellipse cx="132" cy="132" rx="96" ry="64" />
      <ellipse cx="132" cy="132" rx="34" ry="96" />
      <ellipse cx="132" cy="132" rx="64" ry="96" />
      <path d="M36 132h192M132 36v192" />
      <path d="M48 78c28 16 140 16 168 0M48 186c28-16 140-16 168 0" />
      <path d="M214 58c18 8 28 22 34 40" />
      <path d="M248 98h46M294 98v28" />
      <circle cx="248" cy="98" r="2.2" fill="currentColor" stroke="none" />
    </g>
  </svg>
</section>
