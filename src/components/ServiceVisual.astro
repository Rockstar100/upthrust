---
interface Props {
  visual: 'dashboard' | 'identity' | 'product' | 'campaign';
  title: string;
}
const { visual, title } = Astro.props;
---

<div class:list={['visual', `visual-${visual}`]} aria-hidden="true">
  {visual === 'dashboard' && (
    <div class="sv-window">
      <div class="sv-window-bar">
        <span></span><span></span><span></span>
        <div class="sv-window-tab">Overview</div>
      </div>
      <div class="sv-window-body">
        <div class="sv-dash-head">
          <div class="sv-dash-title">Performance</div>
          <div class="sv-dash-pill">+18%</div>
        </div>
        <div class="sv-chart">
          <svg class="sv-line" viewBox="0 0 120 40" preserveAspectRatio="none">
            <polyline points="0,32 20,24 40,28 60,14 80,18 100,6 120,10" />
          </svg>
          <div class="sv-bars"><i></i><i></i><i></i><i></i><i></i><i></i></div>
        </div>
        <div class="sv-chips"><b>Q1</b><b>Q2</b><b>Q3</b><b>Q4</b></div>
      </div>
    </div>
  )}
  {visual === 'identity' && (
    <div class="sv-identity">
      <div class="sv-id-top">
        <span class="sv-swatch"></span>
        <span class="sv-swatch sv-swatch-dark"></span>
        <span class="sv-swatch sv-swatch-line"></span>
        <strong class="sv-wordmark">Aa</strong>
      </div>
      <div class="sv-type-scale">
        <span style="font-size: 1.4rem;">Aa</span>
        <span style="font-size: 1rem;">Aa</span>
        <span style="font-size: 0.7rem;">Aa</span>
      </div>
      <div class="sv-marks">
        <span class="sv-mark sv-mark-circle"></span>
        <span class="sv-mark sv-mark-square"></span>
        <span class="sv-mark sv-mark-diamond"></span>
      </div>
    </div>
  )}
  {visual === 'product' && (
    <div class="sv-device">
      <div class="sv-device-notch"></div>
      <div class="sv-device-screen">
        <div class="sv-device-nav"><span></span><span></span></div>
        <div class="sv-device-hero"></div>
        <div class="sv-device-row"><span class="sv-device-row-line"></span><span class="sv-device-row-line short"></span></div>
        <div class="sv-device-cards"><i></i><i></i></div>
        <div class="sv-device-cta"></div>
      </div>
    </div>
  )}
  {visual === 'campaign' && (
    <div class="sv-campaign">
      <div class="sv-cam-grid">
        <span class="sv-cam-tile sv-cam-a"></span>
        <span class="sv-cam-tile sv-cam-b"></span>
        <span class="sv-cam-tile sv-cam-c"></span>
        <span class="sv-cam-tile sv-cam-d"></span>
      </div>
      <div class="sv-cam-tag">CAMPAIGN</div>
    </div>
  )}
</div>

<style>
  .visual > div {
    width: min(100%, 92%);
  }

  /* Dashboard */
  .sv-window {
    background: #f6f4f1;
    color: var(--ink, #0c0c0c);
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow: 0 1.2rem 2.5rem rgb(0 0 0 / 35%);
  }

  .sv-window-bar {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.65rem;
    background: #e7e2dc;
  }

  .sv-window-bar span {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--orange, #ff3b00);
  }

  .sv-window-bar span:nth-child(2) { opacity: 0.6; }
  .sv-window-bar span:nth-child(3) { opacity: 0.35; }

  .sv-window-tab {
    margin-left: 0.6rem;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(12 12 12 / 55%);
  }

  .sv-window-body { padding: 0.85rem; }

  .sv-dash-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }

  .sv-dash-title {
    font-weight: 600;
    font-size: 0.78rem;
  }

  .sv-dash-pill {
    font-size: 0.62rem;
    font-weight: 600;
    color: #15803d;
    background: #dcfce7;
    padding: 0.12rem 0.4rem;
    border-radius: 999px;
  }

  .sv-chart {
    position: relative;
    height: 4.6rem;
  }

  .sv-line {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .sv-line polyline {
    fill: none;
    stroke: var(--orange, #ff3b00);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .sv-bars {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: end;
    gap: 0.3rem;
    opacity: 0.28;
  }

  .sv-bars i {
    display: block;
    flex: 1;
    background: var(--orange, #ff3b00);
    border-radius: 0.1rem 0.1rem 0 0;
  }

  .sv-bars i:nth-child(1) { height: 35%; }
  .sv-bars i:nth-child(2) { height: 58%; }
  .sv-bars i:nth-child(3) { height: 42%; }
  .sv-bars i:nth-child(4) { height: 78%; }
  .sv-bars i:nth-child(5) { height: 60%; }
  .sv-bars i:nth-child(6) { height: 90%; }

  .sv-chips {
    display: flex;
    gap: 0.35rem;
    margin-top: 0.65rem;
  }

  .sv-chips b {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgb(12 12 12 / 55%);
    border: 1px solid rgb(12 12 12 / 16%);
    padding: 0.14rem 0.4rem;
    border-radius: 0.25rem;
  }

  /* Identity */
  .sv-identity { display: grid; gap: 0.7rem; }

  .sv-id-top {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr auto;
    gap: 0.4rem;
    align-items: end;
  }

  .sv-swatch {
    height: 4rem;
    background: var(--orange, #ff3b00);
    border-radius: 0.2rem;
  }

  .sv-swatch-dark { background: #1a1a1a; border: 1px solid rgb(255 255 255 / 14%); }
  .sv-swatch-line { background: #f2f1ee; }

  .sv-wordmark {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 900;
    font-size: 2.3rem;
    line-height: 0.8;
    color: #f2f1ee;
  }

  .sv-type-scale {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: rgb(255 255 255 / 70%);
    border-top: 1px solid rgb(255 255 255 / 12%);
    padding-top: 0.5rem;
  }

  .sv-marks { display: flex; gap: 0.5rem; }

  .sv-mark {
    width: 1.6rem;
    height: 1.6rem;
    background: var(--orange, #ff3b00);
  }

  .sv-mark-circle { border-radius: 50%; }
  .sv-mark-square { border-radius: 0.25rem; }
  .sv-mark-diamond { transform: rotate(45deg); }

  /* Product */
  .sv-device {
    width: min(10.5rem, 68%);
    border: 1px solid rgb(255 255 255 / 25%);
    border-radius: 1.1rem;
    padding: 0.5rem 0.4rem;
    background: #0d0d0d;
  }

  .sv-device-notch {
    width: 2.2rem;
    height: 0.3rem;
    margin: 0 auto 0.4rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 20%);
  }

  .sv-device-screen {
    display: grid;
    gap: 0.4rem;
    background: #f2f1ee;
    color: var(--ink, #0c0c0c);
    border-radius: 0.6rem;
    padding: 0.55rem;
    min-height: 9rem;
  }

  .sv-device-nav {
    display: flex;
    justify-content: space-between;
  }

  .sv-device-nav span {
    display: block;
    height: 0.3rem;
    width: 1.1rem;
    border-radius: 999px;
    background: rgb(12 12 12 / 25%);
  }

  .sv-device-nav span:first-child { width: 1.6rem; background: var(--orange, #ff3b00); }

  .sv-device-hero {
    height: 2.6rem;
    border-radius: 0.4rem;
    background: linear-gradient(135deg, var(--orange, #ff3b00), #ffb199);
  }

  .sv-device-row { display: grid; gap: 0.25rem; }

  .sv-device-row-line {
    display: block;
    height: 0.3rem;
    border-radius: 999px;
    background: rgb(12 12 12 / 18%);
  }

  .sv-device-row-line.short { width: 60%; }

  .sv-device-cards { display: flex; gap: 0.35rem; }

  .sv-device-cards i {
    flex: 1;
    display: block;
    height: 1.8rem;
    border-radius: 0.3rem;
    background: rgb(12 12 12 / 8%);
    border: 1px solid rgb(12 12 12 / 14%);
  }

  .sv-device-cta {
    height: 1.2rem;
    border-radius: 999px;
    background: var(--ink, #0c0c0c);
  }

  /* Campaign */
  .sv-campaign { position: relative; width: 100%; }

  .sv-cam-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 0.35rem;
    height: 9rem;
  }

  .sv-cam-tile { display: block; border-radius: 0.3rem; }

  .sv-cam-a {
    grid-row: 1 / 3;
    background: linear-gradient(160deg, #ff6a3d, #ff3b00 55%, #7a1d00);
  }

  .sv-cam-b { background: #f2f1ee; }
  .sv-cam-c { background: #2a2a2a; border: 1px solid rgb(255 255 255 / 14%); }
  .sv-cam-d { background: linear-gradient(135deg, #ffd8c2, #ff8a5c); }

  .sv-cam-tag {
    position: absolute;
    bottom: 0.5rem;
    left: 0.5rem;
    background: var(--ink, #0c0c0c);
    color: white;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.45rem;
    border-radius: 0.2rem;
  }
</style>
