---
interface Props {
  title: string;
  intro: string;
  successTitle: string;
  success: string;
  submitLabel: string;
}
const { title, intro, successTitle, success, submitLabel } = Astro.props;
---

<dialog id="contact-dialog" class="contact-dialog" aria-labelledby="contact-title">
  <form id="contact-form" method="post" action="/api/submit" novalidate>
    <div class="dialog-head">
      <h2 id="contact-title">{title}</h2>
      <button class="icon-button" type="button" data-close-contact aria-label="Close">
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <p id="contact-intro">{intro}</p>

    <div class="fields" data-fields>
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required maxlength="120" />
        <p class="error" id="name-error" hidden></p>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" />
        <p class="error" id="email-error" hidden></p>
      </div>
      <div class="field">
        <label for="company">Company <span class="optional">(optional)</span></label>
        <input id="company" name="company" type="text" autocomplete="organization" maxlength="160" />
      </div>
      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" required maxlength="2000" rows="5"></textarea>
        <p class="error" id="message-error" hidden></p>
      </div>
      <div class="hp" inert aria-hidden="true">
        <label for="company_website">Website</label>
        <input id="company_website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <p class="error" id="form-error" hidden></p>
      <button class="submit" type="submit">{submitLabel}</button>
    </div>

    <div class="success" data-success hidden tabindex="-1" role="status">
      <svg class="success-icon" viewBox="0 0 24 24" width="64" height="64" aria-hidden="true">
        <circle cx="12" cy="12" r="12" fill="currentColor" />
        <path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <h2 id="contact-success-title" class="success-title">{successTitle}</h2>
      <p class="success-text">{success}</p>
      <p class="success-meta" data-success-meta hidden>We'll reply to <strong data-success-email></strong>.</p>
      <div class="success-actions">
        <button class="submit" type="button" data-close-contact>Close</button>
        <button class="text-button" type="button" data-send-another>Send another message</button>
      </div>
    </div>
  </form>
</dialog>

<script is:inline>
  const dialog = document.getElementById('contact-dialog');
  const form = document.getElementById('contact-form');
  if (!(dialog instanceof HTMLDialogElement) || !(form instanceof HTMLFormElement)) {
    throw new Error('Contact dialog is missing');
  }

  const fields = form.querySelector('[data-fields]');
  const successNode = form.querySelector('[data-success]');
  const successMeta = form.querySelector('[data-success-meta]');
  const successEmail = form.querySelector('[data-success-email]');
  const formError = document.getElementById('form-error');

  const openers = document.querySelectorAll('[data-open-contact]');

  const setSent = (sent) => {
    dialog.classList.toggle('is-sent', sent);
    dialog.setAttribute('aria-labelledby', sent ? 'contact-success-title' : 'contact-title');
    if (fields instanceof HTMLElement) fields.hidden = sent;
    if (successNode instanceof HTMLElement) successNode.hidden = !sent;
  };

  const showForm = () => {
    form.reset();
    setSent(false);
  };

  const showSuccess = (email) => {
    setSent(true);
    if (successEmail) successEmail.textContent = email;
    if (successMeta instanceof HTMLElement) successMeta.hidden = !email;
    if (successNode instanceof HTMLElement) successNode.focus();
  };

  const clearErrors = () => {
    form.querySelectorAll('.error').forEach((node) => {
      node.textContent = '';
      node.hidden = true;
    });
    form.querySelectorAll('[aria-invalid]').forEach((node) => node.removeAttribute('aria-invalid'));
  };

  const showError = (id, message) => {
    const input = document.getElementById(id);
    const error = document.getElementById(`${id}-error`);
    if (input) input.setAttribute('aria-invalid', 'true');
    if (error) {
      error.textContent = message;
      error.hidden = false;
    }
  };

  const open = () => {
    if (!dialog.open) dialog.showModal();
  };

  openers.forEach((button) => button.addEventListener('click', open));
  form.querySelectorAll('[data-close-contact]').forEach((button) => button.addEventListener('click', () => dialog.close()));
  form.querySelector('[data-send-another]')?.addEventListener('click', () => {
    showForm();
    document.getElementById('name')?.focus();
  });
  dialog.addEventListener('close', () => {
    if (successNode instanceof HTMLElement && !successNode.hidden) showForm();
  });

  if (location.hash === '#contact') open();
  window.addEventListener('hashchange', () => {
    if (location.hash === '#contact') open();
  });

  document.querySelectorAll('a[href="#contact"]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      history.replaceState(null, '', '#contact');
      open();
    });
  });

  const emailOk = (value) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearErrors();

    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const email = String(data.get('email') || '').trim();
    const message = String(data.get('message') || '').trim();
    let valid = true;

    if (!name) {
      showError('name', 'Name is required.');
      valid = false;
    }
    if (!emailOk(email)) {
      showError('email', 'Enter a valid email address.');
      valid = false;
    }
    if (!message) {
      showError('message', 'Message is required.');
      valid = false;
    }
    if (!valid) {
      const first = form.querySelector('[aria-invalid="true"]');
      if (first instanceof HTMLElement) first.focus();
      return;
    }

    const submit = form.querySelector('[type="submit"]');
    if (submit instanceof HTMLButtonElement) submit.disabled = true;

    try {
      const response = await fetch('/api/submit', { method: 'POST', body: data });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) {
        if (payload.fields) {
          for (const [key, message] of Object.entries(payload.fields)) showError(key, String(message));
        }
        if (formError) {
          formError.textContent = payload.error || 'Something went wrong. Try again.';
          formError.hidden = false;
        }
        return;
      }

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'form_submit',
        form_id: 'contact',
      });

      showSuccess(email);
    } catch {
      if (formError) {
        formError.textContent = 'Something went wrong. Try again.';
        formError.hidden = false;
      }
    } finally {
      if (submit instanceof HTMLButtonElement) submit.disabled = false;
    }
  });
</script>
