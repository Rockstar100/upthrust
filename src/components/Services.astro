---
import { existsSync } from 'node:fs';
import path from 'node:path';

interface Service {
  title: string;
  intro: string;
  bullets: string[];
  note?: string;
  image: string;
  imageAlt: string;
  curve: string;
}
interface Props {
  label: string;
  contactLabel: string;
  services: Service[];
}
const { label, contactLabel, services } = Astro.props;

// Images uploaded through the CMS have no -560 copy, so only offer one when it exists.
const srcsetFor = (image: string) => {
  const small = image.replace(/\.webp$/, '-560.webp');
  return small !== image && existsSync(path.join(process.cwd(), 'public', small))
    ? `${small} 560w, ${image} 984w`
    : undefined;
};
---

<section class="services" id="services" aria-label={label}>
  <img
    class="services-grid"
    src="/images/services-grid.webp"
    srcset="/images/services-grid-1440.webp 1440w, /images/services-grid.webp 2880w"
    sizes="max(100vw, 960px)"
    alt=""
    width="1440"
    height="968"
    loading="lazy"
    decoding="async"
    aria-hidden="true"
  />
  <div class="slider" data-slider tabindex="0" aria-roledescription="carousel" aria-label={label}>
    {
      services.map((service, index) => (
        <article
          class:list={['slide', { 'has-note': service.note }]}
          id={`service-${index + 1}`}
          aria-roledescription="slide"
          aria-label={`${index + 1} of ${services.length}`}
        >
          <img class="slide-curve" src={service.curve} alt="" width="1440" height="1051" loading={index ? 'lazy' : undefined} aria-hidden="true" />
          <p class="slide-label">{label}</p>
          <h2 class="slide-title">{service.title}</h2>
          <img
            class="slide-image"
            src={service.image}
            srcset={srcsetFor(service.image)}
            sizes="(min-width: 64rem) min(34.2vw, 492px), (min-width: 36rem) 34rem, calc(100vw - 2.5rem)"
            alt={service.imageAlt}
            width="984"
            height="662"
            loading="lazy"
          />
          <p class="slide-intro">{service.intro}</p>
          <ul class="slide-list">
            {service.bullets.map((item) => <li>{item}</li>)}
          </ul>
          {service.note && <p class="slide-note">{service.note}</p>}
          <button class="slide-contact" type="button" data-open-contact aria-label={`${contactLabel} about ${service.title}`}>
            {contactLabel}
          </button>
        </article>
      ))
    }
  </div>
  <div class="slider-nav">
    <button class="slider-arrow" type="button" data-slide-prev aria-label="Previous service">←</button>
    <div class="slider-dots">
      {
        services.map((service, index) => (
          <button type="button" data-slide-to={index} aria-label={service.title} aria-current={index === 0 ? 'true' : undefined} />
        ))
      }
    </div>
    <button class="slider-arrow" type="button" data-slide-next aria-label="Next service">→</button>
  </div>
</section>

<script>
  const slider = document.querySelector<HTMLElement>('[data-slider]');
  if (slider) {
    const slides = [...slider.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-slide-to]')];
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const current = () => Math.round(slider.scrollLeft / slider.clientWidth);
    const go = (index: number) => {
      const next = (index + slides.length) % slides.length;
      slider.scrollTo({ left: next * slider.clientWidth, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    };
    document.querySelector('[data-slide-prev]')?.addEventListener('click', () => go(current() - 1));
    document.querySelector('[data-slide-next]')?.addEventListener('click', () => go(current() + 1));
    dots.forEach((dot, index) => dot.addEventListener('click', () => go(index)));
    slider.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') go(current() + 1);
      if (event.key === 'ArrowLeft') go(current() - 1);
    });
    const fitHeight = () => {
      slider.style.height = `${slides[current()]?.offsetHeight ?? 0}px`;
    };
    let frame = 0;
    slider.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const active = current();
        dots.forEach((dot, index) => {
          if (index === active) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
        fitHeight();
      });
    });
    new ResizeObserver(fitHeight).observe(slider);
    slides.forEach((slide) => new ResizeObserver(fitHeight).observe(slide));
  }
</script>
