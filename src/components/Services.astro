---
import ServiceVisual from './ServiceVisual.astro';

interface Service {
  title: string;
  summary: string;
  visual: 'dashboard' | 'identity' | 'product' | 'campaign';
}

interface Props {
  title: string;
  body: string;
  contactLabel: string;
  services: Service[];
}
const { title, body, contactLabel, services } = Astro.props;
---

<section class="services" id="services" aria-labelledby="services-title">
  <img
    class="curve"
    src="/images/curve.webp"
    alt=""
    width="3200"
    height="647"
    loading="lazy"
    decoding="async"
  />
  <h2 id="services-title" class="sr-only">{title}</h2>
  <p class="sr-only">{body}</p>
  <ol class="service-list">
    {
      services.map((service) => (
        <li>
          <h3>{service.title}</h3>
          <ServiceVisual visual={service.visual} title={service.title} />
          <p>{service.summary}</p>
          <button class="pill" type="button" data-open-contact>{contactLabel}</button>
        </li>
      ))
    }
  </ol>
</section>
