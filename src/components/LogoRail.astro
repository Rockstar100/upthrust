---
interface Props {
  stat: { value: string; label: string };
  logos: string[];
}
const { stat, logos } = Astro.props;
---

<section class="logo-rail" aria-label="Selected clients">
  <p class="stat">
    <strong>{stat.value}</strong>
    <span>{stat.label}</span>
  </p>
  <ul>
    {logos.map((name) => (
      <li class={`logo-${name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z]/g, '')}`}>{name}</li>
    ))}
  </ul>
</section>
