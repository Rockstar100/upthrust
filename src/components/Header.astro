---
interface Props {
  contactLabel: string;
}
const { contactLabel } = Astro.props;
---

<header class="site-header">
  <a class="logo" href="#top" aria-label="Upthrust home">
    <img src="/brand/logo.svg" alt="" width="157" height="32" />
  </a>
  <button class="header-contact" type="button" data-open-contact aria-label={contactLabel}>
    <img src="/brand/contact-us.svg" alt="" width="156" height="32" />
  </button>
</header>
